                            <constraints>
                                <constraint firstAttribute="width" constant="44" id="pvc-c1-clw"/>
                                <constraint firstAttribute="height" constant="44" id="pvc-c2-clh"/>
                            </constraints>
                            <state key="normal" image="xmark" catalog="system">
                                <preferredSymbolConfiguration key="preferredSymbolConfiguration" configurationType="pointSize" pointSize="18" weight="semibold"/>
                            </state>
                            <connections>
                                <action selector="closeButtonTapped:" destination="-1" eventType="touchUpInside" id="pvc-a1-cls"/>
                            </connections>
                        </button>
